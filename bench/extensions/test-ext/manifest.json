{
  "manifest_version": 3,
  "name": "browsah test extension",
  "version": "1.0",
  "key": "",
  "description": "Used only by the extensions section of the self-test: a content script, a service worker, a popup and native messaging.",
  "permissions": ["storage", "nativeMessaging"],
  "host_permissions": ["http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://localhost/*"], "js": ["content.js"] }],
  "action": { "default_popup": "popup.html", "default_title": "browsah test extension" }
}
