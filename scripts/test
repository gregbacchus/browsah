#!/usr/bin/env bash
# Run targeted tests while developing (see AGENTS.md: be targeted).
#   scripts/test unit [NAME]        unit tests whose name contains NAME (all of them, about a second, without NAME)
#   scripts/test selftest SECTION   one self-test section, or several: install,cookies   (seconds)
#   scripts/test selftest list      show the section names
#   scripts/test selftest all       the whole self-test (about four minutes; before commits that touch shared code)
set -euo pipefail
cd "$(dirname "$0")/.."
export LD_LIBRARY_PATH="$PWD/target/release"
case "${1:-}" in
  unit)
    shift
    cargo test --release "$@"
    ;;
  selftest)
    cargo build --release 2>&1 | grep -E '^(error|warning: unused)' -A8 || true
    case "${2:-}" in
      "") echo "usage: scripts/test selftest SECTION[,SECTION...] | list | all" >&2; exit 2 ;;
      all) timeout 298 ./target/release/browsah --selftest 2>&1 | grep -E 'FAIL|checks passed' ;;
      *)   BROWSAH_SELFTEST_ONLY="$2" timeout 120 ./target/release/browsah --selftest 2>&1 | grep -E 'FAIL|checks passed|SELFTEST_ONLY|^  [a-z_]+$|sections' ;;
    esac
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
